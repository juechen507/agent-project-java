# ===================================================================
# API 配置项总览（模板文件）
# -------------------------------------------------------------------
# 这是 .env.example 模板。复制一份改名为 .env 后填入你的真实值：
#     cp .env.example .env
# 然后在启动前加载到当前 shell：
#     set -a && source .env && set +a
# （.env 已被 .gitignore 忽略，真实 Key 不会被提交）
#
# 说明：两个模块的 application.yml 都用 ${环境变量:默认值} 的形式读取，
#       因此你也可以不用环境变量，直接把 application.yml 里的默认值改成你的值。
# ===================================================================

# ---------- 服务商选择（三选一，取消注释对应那一组即可） ----------

# ① 阿里云 DashScope 兼容模式（本项目默认值）
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AGENT_CHAT_MODEL=qwen-plus
AGENT_EMBEDDING_MODEL=text-embedding-v3
AGENT_EMBEDDING_DIM=1024

# ② DeepSeek（注意：DeepSeek 不提供 embeddings 接口，RAG 相关端点会失败，需另配 embedding 服务或注释掉 RAG 组件）
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_CHAT_MODEL=deepseek-chat

# ③ OpenAI 官方
# AGENT_BASE_URL=https://api.openai.com
# AGENT_CHAT_MODEL=gpt-4o-mini
# AGENT_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_EMBEDDING_DIM=1536

# ---------- 密钥（必填） ----------
AGENT_API_KEY=sk-请替换成你的真实密钥

# ---------- 生成参数（可选，两个模块共用同一组值） ----------
AGENT_TEMPERATURE=0.7
AGENT_TOP_P=1.0
AGENT_MAX_TOKENS=2048
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2

# ---------- 调试：是否打印大模型的原始请求/响应 ----------
AGENT_LOG_REQUESTS=true
AGENT_LOG_RESPONSES=true
